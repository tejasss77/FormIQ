{
  "name": "formiq",
  "version": "1.0.0",
  "description": "FORMIQ — Train better. Move better. Real-time computer-vision fitness coaching platform.",
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir app",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
